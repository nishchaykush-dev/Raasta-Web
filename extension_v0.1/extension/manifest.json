{
  "manifest_version": 3,
  "name": "Saarthi – सारथी",
  "short_name": "Saarthi",
  "version": "0.7.0",
  "description": "Saarthi guides you step by step on any website, in Hindi or English. It only points. It never clicks or types for you.",
  "minimum_chrome_version": "110",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Saarthi: turn ON / OFF for this tab",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
